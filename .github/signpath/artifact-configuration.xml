<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for Radio Widget.
  Paste this into the SignPath project (Artifact configurations → default).

  The release workflow sends two signing requests, each a GitHub artifact (a zip)
  holding one exe: first radio-widget.exe, then RadioWidget_x.y.z_x64-setup.exe.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
