{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radio Widget",
  "version": "0.5.10",
  "identifier": "com.moshiko.radiowidget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Radio",
        "width": 470,
        "height": 206,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "visible": false,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=HardwareMediaKeyHandling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "MoshikoKar",
    "copyright": "Copyright (c) 2026 MoshikoKar. MIT License.",
    "shortDescription": "Internet radio widget for Windows",
    "homepage": "https://github.com/MoshikoKar/radio-widget",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2OEE0QjdGNEFCNEQzQTQKUldTazA3UktmMHVLcGtCbFF6Y3lHb0dlM1pOR21lUytUYmt1dnZyR2FveFd4MDRiMVhmTW5XdW8K",
      "endpoints": [
        "https://github.com/MoshikoKar/radio-widget/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
